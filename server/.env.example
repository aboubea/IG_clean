# Copier en .env et compléter. Aucune de ces variables n'est obligatoire en développement.

# Port et adresse publique (liens de media kit, retours de connexion des réseaux)
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# Postgres. Sans cette variable : base PGlite embarquée dans .data/
# DATABASE_URL=postgres://user:password@host:5432/pulse

# Clé AES-256 qui chiffre les jetons des réseaux, obligatoire en production.
# Générer une fois : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=

# IA : sans clé Anthropic, l'IA fonctionne en mode démo.
# ANTHROPIC_API_KEY=
# PULSE_AI_MODEL=claude-opus-5-5
# PULSE_AI=demo

# Réseaux de démonstration (1 par défaut). Mettre 0 quand les connecteurs officiels sont en place.
# PULSE_DEMO_CONNECTORS=1

# Synchronisation nocturne dans le serveur (1 par défaut) ; 0 si `npm run worker` tourne à part.
# PULSE_INLINE_WORKER=1

# Derrière un proxy ou un CDN : lire la vraie IP cliente (limites de débit).
# TRUST_PROXY=1
